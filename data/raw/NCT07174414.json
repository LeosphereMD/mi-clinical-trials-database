          ]
        }
      ],
      "interventions": [
        {
          "type": "DRUG",
          "name": "Cilostazol 100 mg Tablets",
          "description": "The standard dosing regimen is an initial 2-week period during which participants take one tablet of cilostazol (100 mg) orally once daily followed by a maintenance phase in which they take one tablet twice daily. For participants who are on certain interacting drugs or who experience adverse reactions on the standard dosing regimen, the dose is reduced to half a tablet twice daily.",
          "armGroupLabels": [
            "Cilostazol"
          ]
        },
        {
          "type": "DRUG",
          "name": "Placebo",
          "description": "The standard dosing regimen is an initial 2-week period during which participants take one placebo tablet, which matches cilostazol 100 mg tablets, orally once daily followed by a maintenance phase in which they take one tablet twice daily. For participants who are on certain interacting drugs or who experience adverse reactions on the standard dosing regimen, the dose is reduced to half a tablet twice daily.",
          "armGroupLabels": [
            "Placebo"
          ]
        }
      ]
    },
    "outcomesModule": {
      "primaryOutcomes": [
        {
          "measure": "Time to first occurrence of any component of the composite of ischemic stroke, acute myocardial infarction, or ischemic vascular death (MACE).",
          "description": "Major Adverse Cardiovascular Events (MACE) is a composite outcome. MACE is any one of the following: ischemic stroke, acute myocardial infarction (heart attack), or ischemic vascular death (death caused by a lack of blood flow). In this study, the measure is the time from randomization to a particpant's first MACE.",
          "timeFrame": "Up to 5 years after randomization"
        }
      ],
      "secondaryOutcomes": [
        {
          "measure": "Time to first occurrence of ischemic stroke",
          "description": "Ischemic stroke is a stroke caused by a blocked blood vessel in the brain. The measure is the time from randomization to the first ischemic stroke",
          "timeFrame": "Up to 5 years after randomization"
        },
        {
          "measure": "Time to first occurrence of major hemorrhage",
          "description": "Major hemorrhage is defined as the composite of 'major intracranial hemorrhage' and 'major extracranial hemorrhage', based on the International Society on Thrombosis and Haemostasis (ISTH) criteria. The measure is the time from randomization to the first major hemorrhage.",
          "timeFrame": "Up to 5 years after randomization"
        }
      ]
    },
    "eligibilityModule": {
      "eligibilityCriteria": "Inclusion Criteria:\n\n1. ≥40 years\n2. Ischemic stroke or high-risk TIA (ABCD2 score ≥6)\n3. Can be randomized within 180 days after ischemic stroke or high-risk TIA\n4. Treatment with single or dual antithrombotic therapy with aspirin, clopidogrel and/or ticagrelor per international and/or national guidelines\n5. Two or more of the following risk factors: age 65 years or older, hypertension, diabetes mellitus, history of ischemic stroke other than the qualifying event for this trial, currently smoking, peripheral arterial disease, coronary artery disease including prior MI, aortic atherosclerotic plaque ≥4 mm, ≥50% stenosis or occlusion of a major intracranial artery (ICA, M1, M2, A1, P1, vertebral, or basilar) or extracranial artery (ICA or vertebral)\n6. In the opinion of the site investigator, patient is medically stable, capable of participating in the trial, and willing and able to attend follow-up\n7. Able to receive study drug by mail and able to begin taking study drug promptly after receipt\n8. Provision of signed and dated informed consent form by patient or legally authorized representative\n\nExclusion Criteria:\n\n1. Atrial fibrillation, mechanical heart valve, or left ventricular assist device\n2. Use of prohibited medication (as specified in the MOP)\n3. Modified Rankin Scale 5\n4. Planned cardiac surgery, percutaneous coronary intervention, carotid endarterectomy or stenting (patients are eligible post-procedure)\n5. History of symptomatic non-traumatic intracerebral hemorrhage within last 2 years\n6. Known thrombocytopenia (platelet count ≤100,000 per microliter (µL))\n7. Severe liver dysfunction (active hepatitis or hepatic insufficiency with Child-Pugh score B or C)\n8. Pregnant, breast-feeding, or of child-bearing potential but not on birth control\n9. Confirmed diagnosis of heart failure with current or prior symptoms or signs (e.g. paroxysmal nocturnal dyspnea, reduced exercise tolerance, ankle swelling, elevated jugular venous pressure)\n10. Hypersensitivity to cilostazol or any component of the formulation (e.g. anaphylaxis, angioedema)\n11. Currently enrolled in an investigational intervention study\n12. Life expectancy less than 6 months\n13. Participant does not allow contacting of their surrogate (e.g. family member or friend) or health care practitioner to obtain health information should participant become unwilling or unable to follow the study schedule.\n14. Participants who are incarcerated, including prisoners or participants compulsorily detained for treatment of psychiatric disease.",
      "healthyVolunteers": false,
      "sex": "ALL",
      "minimumAge": "40 Years",
      "stdAges": [
        "ADULT",
        "OLDER_ADULT"
      ]
    },
