# Papers are never committed (CLAUDE.md rule 6)
papers/

# Python
.venv/
__pycache__/
*.pyc

# Files that contain quotes from papers stay local (SPEC.md decision 14).
# Only the public CSV export without quotes is committed.
*.db
*.sqlite
*.sqlite3
extractions/*
!extractions/.gitkeep
verifications/*
!verifications/.gitkeep
review/*
!review/.gitkeep
outcome_checks/*
!outcome_checks/.gitkeep

# Registry-cleaning review files hold no paper quotes and record the
# owner's approvals, so they are committed (SPEC.md "Registry cleaning").
!review/drug_names.csv
!review/drug_name_suggestions_claude.csv
!review/sponsors.csv
!review/why_stopped.csv
!review/outcome_types.csv
!review/outcome_type_suggestions_claude.csv
